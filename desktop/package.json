{
  "name": "chess-coach-desktop",
  "version": "0.1.0",
  "description": "Retro 8-bit desktop UI for the Chess Coach (Electron + React over the Python FastAPI sidecar).",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:api": "cd .. && .venv/bin/python -m src.api",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "web": "concurrently -k -n api,vite -c green,cyan \"npm:dev:api\" \"npm:dev:vite\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-chessboard": "^2.1.3",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  }
}
