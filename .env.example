# Chess Coaching Agent — configuration
# Copy this file to `.env` and fill in the three required values below.

# --- Required ---

# Your OpenAI API key (used only for the `coach` writeup).
OPENAI_API_KEY=sk-...

# --- Optional ---

# Default Chess.com handle for `sync` when --username is omitted. You can analyze
# ANY public account by passing `--username <handle>` on the CLI, so this is just
# a convenience default. The public API is unauthenticated — no key needed.
CHESS_COM_USERNAME=your_chesscom_handle

# Default Lichess handle for `sync --platform lichess` (or `--all-platforms`).
# Reads work anonymously; leave blank and pass --username if you prefer.
LICHESS_USERNAME=

# Optional Lichess personal access token (free: https://lichess.org/account/oauth/token).
# Not required — it only raises rate limits when syncing hundreds of games.
LICHESS_TOKEN=

# Path to the local Stockfish binary. Leave blank to auto-detect from PATH and
# common install locations (e.g. /usr/games/stockfish).
STOCKFISH_PATH=

# --- Optional overrides (sensible defaults; uncomment to change) ---

# OPENAI_MODEL=gpt-4o-mini
# STOCKFISH_DEPTH=18          # 18-22; higher = more accurate but slower
# BULK_STOCKFISH_DEPTH=14     # depth used for large `analyze --all` batches (500+ games)
# STOCKFISH_THREADS=1
# USER_RATING=1500            # calibrates the coaching explanations to your level
# DB_PATH=data/chess_coach.db

# --- RAG / embeddings (Phase 3) ---
# EMBEDDING_MODEL=text-embedding-3-small   # OpenAI embedding model for `index`/`ask`
# RAG_TOP_K=5                 # how many retrieved chunks to feed the model per `ask`
# CRITICAL_EXPLANATIONS=3     # max per-move LLM explanations for `coach --explain`

# --- Desktop app (FastAPI sidecar) ---
# API_HOST=127.0.0.1          # the Electron app and Python sidecar agree on this
# API_PORT=8765
